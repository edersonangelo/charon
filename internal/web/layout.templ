package web

import "fmt"

templ layout(title string, user string, summary Summary) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Charon</title>
			<script src="/static/htmx.min.js"></script>
			<style>
				:root { color-scheme: light dark; --line: #8883; --muted: #8889; }
				* { box-sizing: border-box }
				body { margin: 0; font: 14px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace }
				body > header { display: flex; gap: 1.5rem; align-items: baseline;
				                padding: .75rem 1.25rem; border-bottom: 1px solid var(--line) }
				body > header a { text-decoration: none; font-weight: 600 }
				body > header .spacer { margin-left: auto }
				main { padding: 1.25rem }
				h1 { font-size: 1.1rem; margin: 0 0 1rem }
				table { border-collapse: collapse; width: 100% }
				th, td { text-align: left; padding: .4rem .6rem; border-bottom: 1px solid var(--line);
				         vertical-align: top; white-space: nowrap }
				th { font-weight: 600; color: var(--muted) }
				td.wrap { white-space: normal; word-break: break-all }
				form.filters { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1rem }
				input, select, button { font: inherit; padding: .3rem .5rem;
				                        border: 1px solid var(--line); border-radius: 3px;
				                        background: transparent; color: inherit }
				button { cursor: pointer }
				pre { margin: 0; padding: .75rem; border: 1px solid var(--line); border-radius: 3px;
				      overflow-x: auto; white-space: pre-wrap; word-break: break-all }
				pre.code { word-break: normal; overflow-wrap: anywhere; tab-size: 2;
				           max-height: 28rem; overflow: auto }
				details { margin-top: .5rem }
				summary { cursor: pointer }
				h1 button { font-size: .8rem; padding: .1rem .45rem; vertical-align: middle;
				            margin-left: .5rem }
				.pill { padding: .05rem .4rem; border: 1px solid var(--line); border-radius: 999px;
				        font-size: .8rem }
				.delivered { color: #2a7 } .dead { color: #d44 } .pending { color: #c92 }
				.muted { color: var(--muted) }
				.stats { display: flex; gap: 1rem; margin-left: auto; font-size: .85rem }
				section { margin-bottom: 1.5rem }
				section.attention { border: 1px solid #c92; border-radius: 4px; padding: .75rem 1rem;
				                    background: #cc99221a }
				section.attention h1 { color: #c92 }
				section form { display: flex; gap: .4rem; align-items: center; flex-wrap: wrap; margin: 0 }
				label { display: inline-flex; gap: .25rem; align-items: center; white-space: nowrap }
				section h1.muted { font-size: .85rem; font-weight: 600; margin: 1rem 0 .35rem;
				                   text-transform: uppercase; letter-spacing: .04em }
				tr[data-open] { cursor: pointer }
				tr[data-open]:hover { background: #8881 }
				dialog { width: min(64rem, 92vw); max-height: 86vh; padding: 0;
				         overflow: hidden; border: 1px solid var(--line); border-radius: 6px;
				         background: Canvas; color: CanvasText }
				dialog[open] { display: flex; flex-direction: column }
				dialog::backdrop { background: #0007 }
				dialog .modal-head { flex: 0 0 auto; display: flex; justify-content: flex-end;
				                     padding: .6rem 1rem; border-bottom: 1px solid var(--line) }
				#detail-body { flex: 1 1 auto; overflow: auto; padding: 1rem 1.25rem;
				               overscroll-behavior: contain }
				.scroll { max-width: 100%; overflow: auto }
				.scroll.attempts { max-height: 15rem; overscroll-behavior: contain }
				.scroll.attempts thead th { position: sticky; top: 0; z-index: 1;
				                            background: Canvas; box-shadow: 0 1px 0 var(--line) }
			</style>
		</head>
		<body>
			<header>
				<a href="/events">charon</a>
				<a href="/routes" class="muted">routes</a>
				<span class="stats" id="summary">
					<span class="delivered">{ fmt.Sprint(summary.Delivered) } delivered</span>
					<span class="pending">{ fmt.Sprint(summary.Pending) } pending</span>
					<span class="dead">{ fmt.Sprint(summary.Dead) } dead</span>
					if summary.AwaitingRoute > 0 {
						<span class="muted">{ fmt.Sprint(summary.AwaitingRoute) } awaiting a route</span>
					}
				</span>
				<span class="spacer"></span>
				<span class="muted">{ user }</span>
				<form method="post" action="/logout"><button>sign out</button></form>
			</header>
			<main>
				{ children... }
			</main>
			<dialog id="detail">
				<div class="modal-head"><button onclick="this.closest('dialog').close()">close</button></div>
				<div id="detail-body"></div>
			</dialog>
			<script>
				var modal = document.getElementById("detail");

				document.addEventListener("htmx:afterSwap", function (event) {
					if (event.detail.target.id !== "detail-body") { return; }
					if (!modal.open) { modal.showModal(); }
				});
				modal.addEventListener("click", function (event) {
					if (event.target === modal) { modal.close(); }
				});
				document.body.addEventListener("htmx:configRequest", function (event) {
					var row = event.detail.elt.closest("tr[hx-get]");
					if (row) { modal.dataset.event = row.getAttribute("hx-get").split("/")[2]; }
				});

				// The raw body, never the indented copy: it is the bytes a
				// signature is computed over.
				window.copyBody = function (button) {
					var source = button.closest("section").querySelector(".raw-body");
					if (!source) { return; }
					var text = source.textContent;
					var done = function () {
						var was = button.textContent;
						button.textContent = "copied";
						setTimeout(function () { button.textContent = was; }, 1200);
					};
					if (navigator.clipboard && window.isSecureContext) {
						navigator.clipboard.writeText(text).then(done);
						return;
					}
					var box = document.createElement("textarea");
					box.value = text;
					box.setAttribute("readonly", "");
					box.style.position = "fixed";
					box.style.opacity = "0";
					document.body.appendChild(box);
					box.select();
					document.execCommand("copy");
					document.body.removeChild(box);
					done();
				};

				new EventSource("/stream").onmessage = function () {
					if (document.getElementById("events")) {
						htmx.ajax("GET", location.href,
							{ target: "#events", select: "#events", swap: "outerHTML" });
					}
					htmx.ajax("GET", location.href,
						{ target: "#summary", select: "#summary", swap: "outerHTML" });
					if (modal.open && modal.dataset.event) {
						htmx.ajax("GET", "/events/" + modal.dataset.event + "/fragment",
							{ target: "#detail-body", swap: "innerHTML" });
					}
				};
			</script>
		</body>
	</html>
}

templ loginPage(failed bool, sso bool, notice string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>Sign in · Charon</title>
			<style>
				:root { color-scheme: light dark }
				body { margin: 0; height: 100vh; display: grid; place-items: center;
				       font: 14px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace }
				form { display: grid; gap: .6rem; width: 18rem }
				h1 { font-size: 1.1rem; margin: 0 0 .5rem }
				input, button { font: inherit; padding: .4rem .5rem;
				                border: 1px solid #8883; border-radius: 3px;
				                background: transparent; color: inherit }
				button { cursor: pointer }
				.error { color: #d44 }
			</style>
		</head>
		<body>
			<form method="post" action="/login">
				<h1>charon</h1>
				if failed {
					<span class="error">wrong email or password</span>
				}
				if notice != "" {
					<span class="error">{ notice }</span>
				}
				<input type="email" name="email" placeholder="email" required autofocus/>
				<input type="password" name="password" placeholder="password" required/>
				<button>sign in</button>
				if sso {
					<a href="/auth/sso"><button type="button">sign in with single sign-on</button></a>
				}
			</form>
		</body>
	</html>
}
